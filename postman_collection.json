{
  "info": {
    "_postman_id": "product-catalog-api-collection",
    "name": "Product Catalog API",
    "description": "Complete API collection for Product Catalog with ElasticSearch, Redis Cache and AWS S3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "product_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/api/health",
        "description": "Check API health"
      }
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?page=1&per_page=15&status=active&sort=created_at&order=desc",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "15" },
                { "key": "status", "value": "active", "disabled": true },
                { "key": "category", "value": "Electronics", "disabled": true },
                { "key": "min_price", "value": "100", "disabled": true },
                { "key": "max_price", "value": "1000", "disabled": true },
                { "key": "sort", "value": "created_at" },
                { "key": "order", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"LAPTOP-PRO-001\",\n  \"name\": \"Laptop Pro 16\",\n  \"description\": \"High-performance laptop with 16GB RAM and 512GB SSD\",\n  \"price\": 1299.99,\n  \"category\": \"Electronics\",\n  \"status\": \"active\"\n}"
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/{{product_id}}"
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/products/{{product_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 999.99,\n  \"status\": \"inactive\"\n}"
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/products/{{product_id}}"
          }
        },
        {
          "name": "Upload Product Image",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products/{{product_id}}/image",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "Select a JPG or PNG image (max 5MB)"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Search (ElasticSearch)",
      "item": [
        {
          "name": "Search All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/search/products",
              "host": ["{{base_url}}"],
              "path": ["search", "products"]
            }
          }
        },
        {
          "name": "Search by Query",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/search/products?q=laptop&page=1&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["search", "products"],
              "query": [
                { "key": "q", "value": "laptop" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search with All Filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/search/products?q=laptop&category=Electronics&min_price=500&max_price=2000&status=active&sort=price&order=asc&page=1&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["search", "products"],
              "query": [
                { "key": "q", "value": "laptop" },
                { "key": "category", "value": "Electronics" },
                { "key": "min_price", "value": "500" },
                { "key": "max_price", "value": "2000" },
                { "key": "status", "value": "active" },
                { "key": "sort", "value": "price" },
                { "key": "order", "value": "asc" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "15" }
              ]
            }
          }
        },
        {
          "name": "Search by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/search/products?category=Electronics&status=active",
              "host": ["{{base_url}}"],
              "path": ["search", "products"],
              "query": [
                { "key": "category", "value": "Electronics" },
                { "key": "status", "value": "active" }
              ]
            }
          }
        },
        {
          "name": "Search by Price Range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/search/products?min_price=100&max_price=500&sort=price&order=asc",
              "host": ["{{base_url}}"],
              "path": ["search", "products"],
              "query": [
                { "key": "min_price", "value": "100" },
                { "key": "max_price", "value": "500" },
                { "key": "sort", "value": "price" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        }
      ]
    }
  ]
}
